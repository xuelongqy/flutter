+DART_EXPORT Dart_FlaxGCEpoch Dart_FlaxTryBeginEmbedderGC(void* collector_peer) {
+  Thread* thread = Thread::Current();
+  if (!FlaxCanEnterEmbedderGC(thread) || !flax_embedder_gc ||
+      flax_embedder_gc->owner != thread || flax_embedder_gc->epoch != 0) {
+    return 0;
+  }
+
+  thread->ExitSafepointFromNative();
+  thread->set_execution_state(Thread::kThreadInVM);
+  const Dart_FlaxGCEpoch epoch =
+      thread->heap()->TryBeginFlaxEmbedderGC(thread, collector_peer);
+  RELEASE_ASSERT(!thread->OwnsSafepoint() && !thread->IsAtSafepoint());
+  if (epoch == 0) {
+    thread->set_execution_state(Thread::kThreadInNative);
+    thread->EnterSafepointToNative();
+  }
+  return epoch;
+}
+
+Dart_FlaxGCEpoch Heap::TryBeginFlaxEmbedderGC(Thread* thread,
+                                            void* collector_peer) {
+  auto* api = isolate_group_->api_state();
+  NoActiveIsolateScope no_active_isolate_scope(thread);
+  GcSafepointOperationScope safepoint_operation(thread);
+  {
+    MonitorLocker ml(old_space_.tasks_lock());
+    if (old_space_.phase() != PageSpace::kDone || old_space_.tasks() != 0) {
+      TIMELINE_FUNCTION_GC_DURATION(thread, "FlaxJoinRejectDartHeapBusy");
+      return 0;
+    }
+  }
+  if (thread->is_marking() || api->flax_epoch() != 0 ||
+      api->flax_callback_active() || api->flax_owner() != thread ||
+      api->flax_collector() == nullptr || api->flax_peer() != collector_peer) {
+    TIMELINE_FUNCTION_GC_DURATION(thread, "FlaxJoinRejectDartOwnership");
+    return 0;
+  }
+  CollectOldSpaceGarbageAtSafepoint(thread, GCType::kMarkSweep,
+                                    GCReason::kDebugging,
+                                    /*defer_flax_tracing=*/false,
+                                    /*stage_flax=*/true);
+  const auto epoch = api->flax_epoch();
+  RELEASE_ASSERT(epoch != 0);
+  flax_embedder_gc->epoch = epoch;
+  api->set_flax_callback_active(true);
+  thread->IncrementNoCallbackScopeDepth();
+  return epoch;
+}
+
+DART_EXPORT bool Dart_FlaxFinishEmbedderGC(Dart_FlaxGCEpoch epoch,
+                                           bool commit) {
+  Thread* thread = Thread::Current();
+  if (!flax_embedder_gc || flax_embedder_gc->owner != thread || epoch == 0 ||
+      flax_embedder_gc->epoch != epoch) {
+    return false;
+  }
+  RELEASE_ASSERT(thread->execution_state() == Thread::kThreadInVM);
+  RELEASE_ASSERT(!thread->OwnsSafepoint() && !thread->IsAtSafepoint());
+  RELEASE_ASSERT(thread->no_callback_scope_depth() == 1);
+  RELEASE_ASSERT(thread->no_safepoint_scope_depth() == 0);
+  const bool committed =
+      thread->heap()->FinishFlaxEmbedderGC(thread, epoch, commit);
+  RELEASE_ASSERT(!thread->OwnsSafepoint() && !thread->IsAtSafepoint());
+  flax_embedder_gc->epoch = 0;
+  thread->DecrementNoCallbackScopeDepth();
+  thread->set_execution_state(Thread::kThreadInNative);
+  thread->EnterSafepointToNative();
+  return committed;
+}
+
+bool Heap::FinishFlaxEmbedderGC(Thread* thread,
+                                Dart_FlaxGCEpoch epoch,
+                                bool commit) {
+  NoActiveIsolateScope no_active_isolate_scope(thread);
+  GcSafepointOperationScope safepoint_operation(thread);
+  auto* api = isolate_group_->api_state();
+  RELEASE_ASSERT(api->flax_owner() == thread && api->flax_callback_active());
+  // Acquiring the safepoint can park the owner for a foreign GC. In that
+  // case the old visitor is gone and the foreign GC has kept the Dart peers.
+  if (api->flax_epoch() == epoch) {
+    RELEASE_ASSERT(old_space_.phase() == PageSpace::kAwaitingFlax);
+    CollectOldSpaceGarbageAtSafepoint(thread, GCType::kMarkSweep,
+                                      GCReason::kDebugging,
+                                      /*defer_flax_tracing=*/!commit,
+                                      /*stage_flax=*/false);
+  } else {
+    RELEASE_ASSERT(api->flax_epoch() == 0);
+    api->RequestFlaxCollection();
+    commit = false;
   }
+  api->set_flax_callback_active(false);
+  return commit;
 }
 

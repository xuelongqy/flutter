+struct FlaxEmbedderGC {
+  FlaxEmbedderGC(Thread* owner, SafepointRwLock* lock)
+      // The reservation spans embedder calls, outside the VM unwind chain.
+      : owner(owner), isolates_lock(/*thread_state=*/nullptr, lock) {}
+
+  Thread* const owner;
+  SafepointReadRwLocker isolates_lock;
+  Dart_FlaxGCEpoch epoch = 0;
+  int64_t closed_at = -1;
+};
+
+thread_local std::optional<FlaxEmbedderGC> flax_embedder_gc;
+thread_local int64_t flax_cancelled_gate_micros = -1;
+
+bool FlaxCanEnterEmbedderGC(Thread* thread) {
+  return thread != nullptr && thread->isolate() != nullptr &&
+         thread->IsDartMutatorThread() && !thread->BypassSafepoints() &&
+         thread->execution_state() == Thread::kThreadInNative &&
+         thread->no_callback_scope_depth() == 0 &&
+         thread->no_safepoint_scope_depth() == 0 && !thread->OwnsSafepoint() &&
+         thread->IsAtSafepoint() && !thread->force_growth() &&
+         !FLAG_use_compactor && FLAG_marker_tasks > 0;
+}

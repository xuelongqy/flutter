+DART_EXPORT int32_t Dart_FlaxTryReserveEmbedderGC(void* collector_peer) {
+  Thread* thread = Thread::Current();
+  if (!FlaxCanEnterEmbedderGC(thread) || flax_embedder_gc ||
+      flax_cancelled_gate_micros != -1 ||
+      !thread->TryExitSafepointFromNative()) {
+    return 0;
+  }
+
+  // The fast exit proves this owner slot has not been stolen. The reservation
+  // prevents stealing until its release, including the time in native code.
+  thread->set_execution_state(Thread::kThreadInVM);
+  const int32_t isolates =
+      thread->heap()->TryReserveFlaxEmbedderGC(thread, collector_peer);
+  thread->set_execution_state(Thread::kThreadInNative);
+  thread->EnterSafepointToNative();
+  return isolates;
+}
+
+int32_t Heap::TryReserveFlaxEmbedderGC(Thread* thread, void* collector_peer) {
+  if (!thread->CanAcquireSafepointLocks()) return 0;
+
+  auto* group = isolate_group_;
+  auto& gc = flax_embedder_gc.emplace(thread, group->isolates_lock_.get());
+  intptr_t count = 0;
+  for (auto it = group->isolates_.begin(); it != group->isolates_.end(); ++it) {
+    ++count;
+  }
+  if (count < 1 || count > 2 || count != group->isolate_count_ ||
+      group->isolates_.First() != thread->isolate() ||
+      group->group_mutator_count_ != 0 ||
+      !group->TryCloseFlaxWorkerGate(thread, &gc.closed_at)) {
+    flax_embedder_gc.reset();
+    return 0;
+  }
+
+  // A concurrent job can have been queued without entering the registry.
+  // Check after closing admission, without nesting the scheduler monitors.
+  bool idle;
+  {
+    MonitorLocker ml(old_space_.tasks_lock());
+    idle = old_space_.phase() == PageSpace::kDone && old_space_.tasks() == 0;
+  }
+  auto* api = group->api_state();
+  if (!idle || thread->is_marking() || api->flax_epoch() != 0 ||
+      api->flax_callback_active() || api->flax_owner() != thread ||
+      api->flax_collector() == nullptr || api->flax_peer() != collector_peer) {
+    ReleaseFlaxWorkerGate(thread);
+    return 0;
+  }
+  return count;
+}
+
+int64_t Heap::ReleaseFlaxWorkerGate(Thread* thread) {
+  RELEASE_ASSERT(flax_embedder_gc && flax_embedder_gc->owner == thread);
+  RELEASE_ASSERT(flax_embedder_gc->epoch == 0 && !thread->OwnsSafepoint());
+  const int64_t closed_at = flax_embedder_gc->closed_at;
+  RELEASE_ASSERT(closed_at >= 0);
+  flax_embedder_gc.reset();
+  return isolate_group_->OpenFlaxWorkerGate(thread, closed_at);
+}
+
+void Heap::CancelFlaxWorkerGateOnIsolateExit(Thread* thread) {
+  if (flax_embedder_gc && flax_embedder_gc->owner == thread) {
+    // For example, a group-bound FFI callback may deschedule the owner before
+    // the foreground pump reaches a major. Release before it tries to reenter.
+    flax_cancelled_gate_micros = thread->heap()->ReleaseFlaxWorkerGate(thread);
+  }
+}
+
+DART_EXPORT int64_t Dart_FlaxReleaseEmbedderGCReservation() {
+  if (flax_cancelled_gate_micros != -1) {
+    return std::exchange(flax_cancelled_gate_micros, -1);
+  }
+  Thread* thread = Thread::Current();
+  RELEASE_ASSERT(thread != nullptr);
+  return thread->heap()->ReleaseFlaxWorkerGate(thread);
+}

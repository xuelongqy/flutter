+// Real Type components; names are diagnostic/source identity, never type syntax.
+DART_EXPORT Dart_Handle Dart_FlaxTypeParts(Dart_Handle input) {
+  DARTSCOPE(Thread::Current());
+  CHECK_CALLBACK_STATE(T);
+  const auto& object = Object::Handle(Z, Api::UnwrapHandle(input));
+  if (!object.IsAbstractType()) return Api::NewArgumentError("Expected a Dart Type");
+  const auto& type = AbstractType::Cast(object);
+  if (!type.IsInstantiated()) return Api::NewArgumentError("Type must be instantiated");
+  const auto& result = Array::Handle(Z, Array::New(7));
+  result.SetAt(0, String::Handle(Z, type.UserVisibleName()));
+  result.SetAt(1, Bool::Get(type.IsNullable()));
+  // VM pseudo-types have no declaring library or superclass metadata.
+  if (type.IsDynamicType() || type.IsVoidType() || type.IsNeverType() ||
+      type.IsNullType()) {
+    const char* name = type.IsDynamicType() ? "dynamic"
+                       : type.IsVoidType() ? "void"
+                       : type.IsNeverType() ? "Never" : "Null";
+    result.SetAt(2, String::Handle(Z, String::New("dart:core")));
+    result.SetAt(3, String::Handle(Z, String::New(name)));
+    result.SetAt(4, Array::Handle(Z, Array::New(0)));
+    result.SetAt(6, Array::Handle(Z, Array::New(0)));
+    return Api::NewHandle(T, result.ptr());
+  }
+  if (type.IsType()) {
+    const auto& concrete = Type::Cast(type);
+    const auto& cls = Class::Handle(Z, concrete.type_class());
+    const auto& lib = Library::Handle(Z, cls.library());
+    result.SetAt(2, String::Handle(Z, lib.url()));
+    result.SetAt(3, String::Handle(Z, cls.UserVisibleName()));
+    const auto& args = TypeArguments::Handle(Z, concrete.arguments());
+    const intptr_t count = cls.NumTypeParameters();
+    if (!args.IsNull() && count != args.Length()) {
+      return Api::NewError("Invalid Type argument layout: %s (own=%" Pd ", length=%" Pd ")",
+                           String::Handle(Z, type.UserVisibleName()).ToCString(),
+                           count, args.Length());
+    }
+    const auto& children = Array::Handle(Z, Array::New(count));
+    auto& child = AbstractType::Handle(Z);
+    for (intptr_t i = 0; i < count; ++i) {
+      child = args.TypeAtNullSafe(i);
+      children.SetAt(i, child);
+    }
+    result.SetAt(4, children);
+    const auto& interfaces = Array::Handle(Z, cls.interfaces());
+    const intptr_t interface_count = interfaces.IsNull() ? 0 : interfaces.Length();
+    const auto& parent = Type::Handle(Z, cls.super_type());
+    const auto& parents = Array::Handle(Z, Array::New(interface_count + (parent.IsNull() ? 0 : 1)));
+    const auto& function_args = TypeArguments::Handle(Z, Object::empty_type_arguments().ptr());
+    // Type.arguments contains only its own parameters; superclass substitution
+    // uses the VM's flattened instance vector.
+    const auto& instance_args = TypeArguments::Handle(Z, concrete.GetInstanceTypeArguments(T));
+    intptr_t index = 0;
+    if (!parent.IsNull()) {
+      child = parent.IsInstantiated() ? parent.ptr() : parent.InstantiateFrom(instance_args, function_args, kAllFree, Heap::kOld);
+      parents.SetAt(index++, child);
+    }
+    for (intptr_t i = 0; i < interface_count; ++i) {
+      child ^= interfaces.At(i);
+      if (!child.IsInstantiated())
+        child = child.InstantiateFrom(instance_args, function_args, kAllFree, Heap::kOld);
+      parents.SetAt(index++, child);
+    }
+    result.SetAt(6, parents);
+  } else if (type.IsRecordType()) {
+    const auto& record = RecordType::Cast(type);
+    result.SetAt(2, String::Handle(Z, String::New("dart:core")));
+    result.SetAt(3, String::Handle(Z, String::New("Record")));
+    result.SetAt(4, Array::Handle(Z, record.field_types()));
+    result.SetAt(5, Array::Handle(Z, record.GetFieldNames(T)));
+  } else if (type.IsFunctionType()) {
+    const auto& function = FunctionType::Cast(type);
+    if (function.IsGeneric())
+      return Api::NewArgumentError("Unbound generic callback type");
+    const intptr_t offset = function.num_implicit_parameters();
+    const intptr_t fixed = function.num_fixed_parameters() - offset;
+    const intptr_t positional = fixed + function.NumOptionalPositionalParameters();
+    const intptr_t count = function.NumParameters() - offset;
+    const auto& children = Array::Handle(Z, Array::New(count + 1));
+    auto& child = AbstractType::Handle(Z);
+    for (intptr_t i = 0; i < count; ++i) {
+      child = function.ParameterTypeAt(offset + i);
+      children.SetAt(i, child);
+    }
+    child = function.result_type();
+    children.SetAt(count, child);
+    const intptr_t named = function.NumOptionalNamedParameters();
+    const auto& names = Array::Handle(Z, Array::New(named));
+    const auto& required = Array::Handle(Z, Array::New(named));
+    for (intptr_t i = 0; i < named; ++i) {
+      names.SetAt(i, String::Handle(Z, function.ParameterNameAt(offset + positional + i)));
+      required.SetAt(i, Bool::Get(function.IsRequiredAt(offset + positional + i)));
+    }
+    const auto& shape = Array::Handle(Z, Array::New(4));
+    shape.SetAt(0, Smi::Handle(Z, Smi::New(positional)));
+    shape.SetAt(1, Smi::Handle(Z, Smi::New(fixed)));
+    shape.SetAt(2, names);
+    shape.SetAt(3, required);
+    result.SetAt(2, String::Handle(Z, String::New("dart:core")));
+    result.SetAt(3, String::Handle(Z, String::New("Function")));
+    result.SetAt(4, children);
+    result.SetAt(5, shape);
+  } else {
+    return Api::NewArgumentError("Unsupported Dart Type representation");
+  }
+  return Api::NewHandle(T, result.ptr());
+}

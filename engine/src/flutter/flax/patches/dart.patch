+struct FlaxIncrementalCollectionState {
+  Dart_WeakPersistentHandle live = nullptr;
+  Dart_WeakPersistentHandle dead = nullptr;
+  bool live_finalized = false;
+  bool dead_finalized = false;
+  intptr_t collections = 0;
+  intptr_t requests = 0;
+};
+
+static void FlaxIncrementalCollectionFinalizer(void* isolate_callback_data,
+                                               void* peer) {
+  *static_cast<bool*>(peer) = true;
+}
+
+static void FlaxIncrementalCollector(void* peer, Dart_FlaxGCEpoch epoch) {
+  auto* state = static_cast<FlaxIncrementalCollectionState*>(peer);
+  ++state->collections;
+  EXPECT(!Thread::Current()->OwnsGCSafepoint());
+  EXPECT_EQ(Thread::kThreadInVM, Thread::Current()->execution_state());
+  EXPECT(!state->live_finalized);
+  EXPECT(!state->dead_finalized);
+  bool all_targets_marked = true;
+  EXPECT(Dart_FlaxGCCheckpoint(epoch, nullptr, 0, nullptr, nullptr,
+                               &all_targets_marked));
+  EXPECT(!all_targets_marked);
+  EXPECT(Dart_FlaxGCCheckpoint(epoch, &state->live, 1, nullptr, nullptr,
+                               &all_targets_marked));
+  EXPECT(!all_targets_marked);  // The rootless target is still unmarked.
+}
+
+static void FlaxIncrementalCollectionRequest(void* peer) {
+  ++static_cast<FlaxIncrementalCollectionState*>(peer)->requests;
+}
+
+TEST_CASE(DartAPI_FlaxCollectAllGarbageFinishesIncremental) {
+  auto* heap = thread->heap();
+  {
+    TransitionNativeToVM transition(thread);
+    GCTestHelper::CollectAllGarbage();
+  }
+  FlaxIncrementalCollectionState state;
+  Dart_Handle business_root = AllocateOldString("business root");
+  EXPECT(Dart_FlaxSetCollector(FlaxIncrementalCollector, &state));
+  Dart_FlaxSetCollectionRequest(FlaxIncrementalCollectionRequest);
+  {
+    Dart_EnterScope();
+    ForceGrowthScope force_growth(thread);
+    Dart_Handle live = AllocateOldString("conditional live target");
+    Dart_Handle dead;
+    {
+      TransitionNativeToVM transition(thread);
+      dead = Api::NewHandle(thread, Array::New(1, Heap::kOld));
+    }
+    EXPECT_VALID(Dart_ListSetAt(dead, 0, dead));
+    state.live = Dart_NewWeakPersistentHandle(
+        live, &state.live_finalized, 0, FlaxIncrementalCollectionFinalizer);
+    state.dead = Dart_NewWeakPersistentHandle(
+        dead, &state.dead_finalized, 0, FlaxIncrementalCollectionFinalizer);
+    EXPECT(Dart_FlaxRegisterHandle(state.live, false));
+    EXPECT(Dart_FlaxRegisterHandle(state.dead, false));
+    Dart_ExitScope();
+  }
+  {
+    TransitionNativeToVM transition(thread);
+    auto* old_space = heap->old_space();
+    const bool concurrent_mark = old_space->enable_concurrent_mark();
+    old_space->set_enable_concurrent_mark(true);
+    heap->StartConcurrentMarking(thread, GCReason::kDebugging);
+    EXPECT(thread->is_marking());
+    heap->CollectAllGarbage(GCReason::kDebugging);
+    EXPECT(!thread->is_marking());
+    old_space->set_enable_concurrent_mark(concurrent_mark);
+  }
+  EXPECT_EQ(1, state.collections);
+  EXPECT_EQ(0, state.requests);
+  EXPECT(!state.live_finalized);
+  EXPECT(state.dead_finalized);
+  EXPECT(Dart_IsNull(AsHandle(state.dead)));
+  const char* value = nullptr;
+  EXPECT_VALID(Dart_StringToCString(AsHandle(state.live), &value));
+  EXPECT_STREQ("conditional live target", value);
+  EXPECT_VALID(Dart_StringToCString(business_root, &value));
+  EXPECT_STREQ("business root", value);
+  Dart_DeleteWeakPersistentHandle(state.live);
+  Dart_DeleteWeakPersistentHandle(state.dead);
+  EXPECT(Dart_FlaxSetCollector(nullptr, nullptr));
+}

+bool IsolateGroup::TryCloseFlaxWorkerGate(Thread* owner, int64_t* closed_at) {
+  MonitorLocker mutators(active_mutators_monitor_.get());
+  if (flax_worker_gate_owner_ != nullptr || active_mutators_ != 1) {
+    return false;
+  }
+  MonitorLocker threads(thread_registry()->threads_lock());
+  if (safepoint_handler()->AnySafepointInProgressLocked()) {
+    return false;
+  }
+  for (Thread* peer = thread_registry()->active_list(); peer != nullptr;
+       peer = peer->next()) {
+    if (peer == owner) continue;
+    // Check stack state only after confirming detachment. A group-bound FFI
+    // handoff can suspend a peer with live Dart frames and drop its slot.
+    if (!peer->IsDartMutatorThread() || peer->BypassSafepoints() ||
+        peer->scheduled_dart_mutator_isolate() == nullptr ||
+        !peer->IsAtSafepoint() || peer->os_thread() != nullptr ||
+        peer->HasActiveState()) {
+      return false;
+    }
+  }
+  *closed_at = OS::GetCurrentMonotonicMicros();
+  flax_worker_gate_owner_ = owner;
+  return true;
+}
+
+int64_t IsolateGroup::OpenFlaxWorkerGate(Thread* owner, int64_t closed_at) {
+  MonitorLocker mutators(active_mutators_monitor_.get());
+  MonitorLocker threads(thread_registry()->threads_lock());
+  RELEASE_ASSERT(flax_worker_gate_owner_ == owner);
+  RELEASE_ASSERT(!safepoint_handler()->AnySafepointInProgressLocked());
+  const int64_t elapsed = OS::GetCurrentMonotonicMicros() - closed_at;
+  flax_worker_gate_owner_ = nullptr;
+  threads.NotifyAll();
+  mutators.NotifyAll();
+  return elapsed;
+}

+DART_EXPORT bool Dart_FlaxSetCollector(Dart_FlaxCollector collector,
+                                       void* peer) {
+  Thread* T = Thread::Current();
+  CHECK_ISOLATE_GROUP(T->isolate_group());
+  TransitionToVM transition(T);
+  return T->isolate_group()->api_state()->SetFlaxCollector(collector, peer, T);
+}
+
+DART_EXPORT bool Dart_FlaxRegisterHandle(Dart_WeakPersistentHandle handle,
+                                         bool is_origin) {
+  Thread* T = Thread::Current();
+  CHECK_ISOLATE_GROUP(T->isolate_group());
+  TransitionToVM transition(T);
+  auto* state = T->isolate_group()->api_state();
+  if (state->flax_owner() != T) return false;
+  return state->RegisterFlaxHandle(handle, is_origin);
+}
+
+DART_EXPORT void Dart_FlaxSetCollectionRequest(void (*request)(void*)) {
+  Thread* T = Thread::Current();
+  CHECK_ISOLATE_GROUP(T->isolate_group());
+  TransitionToVM transition(T);
+  RELEASE_ASSERT(T->isolate_group()->api_state()->flax_owner() == T);
+  T->isolate_group()->api_state()->SetFlaxCollectionRequest(request);
+}
+
+DART_EXPORT void Dart_FlaxCollect(bool young, bool compact) {
+  DARTSCOPE(Thread::Current());
+  if (young) {
+    T->heap()->CollectGarbage(T, GCType::kScavenge, GCReason::kDebugging);
+  } else {
+    T->heap()->CollectAllGarbage(GCReason::kDebugging, compact);
+  }
+}

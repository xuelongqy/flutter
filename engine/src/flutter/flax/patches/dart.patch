+    if (--it->second.users == 0) {
+      pin->page->set_never_evacuate(it->second.originally_fixed);
+      uint8_pinned_pages.erase(it);
+    }
+  }
+  pin->state->FreePersistentHandle(pin->root);
+  uint8_pins.erase(pin);
+  pin->root = nullptr;
+  pin->page = nullptr;

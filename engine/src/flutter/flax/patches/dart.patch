+static void FlaxMovingCollector(void* peer, Dart_FlaxGCEpoch epoch) {
+  auto* state = static_cast<FlaxEpochTestState*>(peer);
+  auto* thread = Thread::Current();
+  EXPECT(!thread->OwnsGCSafepoint());
+  EXPECT_EQ(Thread::kThreadInVM, thread->execution_state());
+  EXPECT(!Dart_FlaxGCCheckpoint(state->previous_epoch, nullptr, 0,
+                                FlaxEpochOrigin, state, nullptr));
+  state->previous_epoch = epoch;
+  state->origins = 0;
+  EXPECT(Dart_FlaxGCCheckpoint(epoch, nullptr, 0, FlaxEpochOrigin, state,
+                               nullptr));
+  EXPECT_EQ(state->abort ? 1 : 0, state->origins);
+  if (!state->abort) return;
+  state->abort = false;
+  auto* slot = reinterpret_cast<FinalizablePersistentHandle*>(state->target);
+  EXPECT(slot->ptr()->IsOldObject());
+  EXPECT(!Page::Of(slot->ptr())->is_large());
+  EXPECT(!Page::Of(slot->ptr())->is_never_evacuate());
+  EXPECT(!Page::Of(slot->ptr())->is_evacuation_candidate());
+  const uword before = UntaggedObject::ToAddr(slot->ptr());
+  {
+    // Compact alone can leave an object in place; force an observable move.
+    SetFlagScope<bool> force_evacuation(&FLAG_force_evacuation, true);
+    thread->heap()->CollectGarbage(thread, GCType::kMarkCompact,
+                                   GCReason::kDebugging);
+  }
+  EXPECT(!slot->IsFinalizedNotFreed());
+  EXPECT(slot->ptr()->IsOldObject());
+  EXPECT_NE(before, UntaggedObject::ToAddr(slot->ptr()));
+  EXPECT(!Dart_FlaxGCCheckpoint(epoch, nullptr, 0, FlaxEpochOrigin, state,
+                                nullptr));
+  EXPECT(!state->target_finalized);
+  EXPECT(!state->origin_finalized);
+  EXPECT(!state->dead_finalized);
+}

+DART_EXPORT Dart_Handle Dart_FlaxInstantiate(Dart_Handle callable,
+                                          Dart_Handle type_list) {
+  DARTSCOPE(Thread::Current());
+  CHECK_CALLBACK_STATE(T);
+  const auto& input = Object::Handle(Z, Api::UnwrapHandle(callable));
+  if (!input.IsClosure()) return Api::NewArgumentError("Expected a generic closure");
+  const auto& closure = Closure::Cast(input);
+  const auto& target = Function::Handle(Z, closure.function());
+  const intptr_t count = target.NumTypeParameters();
+  if (!target.IsGeneric() || closure.delayed_type_arguments() != Object::empty_type_arguments().ptr())
+    return Api::NewArgumentError("Closure must have unbound type parameters");
+  const auto& list = Object::Handle(Z, Api::UnwrapHandle(type_list));
+  if (!list.IsArray() && !list.IsGrowableObjectArray())
+    return Api::NewArgumentError("Expected a List<Type>");
+  const intptr_t length = list.IsArray() ? Array::Cast(list).Length()
+                                        : GrowableObjectArray::Cast(list).Length();
+  if (length != count) return Api::NewArgumentError("Wrong number of type arguments");
+  const auto& types = TypeArguments::Handle(Z, TypeArguments::New(count));
+  auto& item = Object::Handle(Z);
+  for (intptr_t i = 0; i < count; ++i) {
+    item = list.IsArray() ? Array::Cast(list).At(i) : GrowableObjectArray::Cast(list).At(i);
+    if (!item.IsAbstractType() || !AbstractType::Cast(item).IsInstantiated())
+      return Api::NewArgumentError("Expected an instantiated Dart Type");
+    types.SetTypeAt(i, AbstractType::Cast(item));
+  }
+  const auto& canonical = TypeArguments::Handle(Z, types.Canonicalize(T));
+  const auto& lib = Library::Handle(Z, Library::InternalLibrary());
+  const auto& name = String::Handle(Z, Symbols::New(T, "_instantiateClosure"));
+  const auto& factory = Function::Handle(Z, lib.LookupFunctionAllowPrivate(name));
+  if (factory.IsNull()) return Api::NewError("Missing retained closure instantiation entry point");
+  const auto& args = Array::Handle(Z, Array::New(2));
+  args.SetAt(0, closure);
+  args.SetAt(1, canonical);
+  const auto& result = Object::Handle(Z, DartEntry::InvokeFunction(factory, args));
+  return Api::NewHandle(T, result.ptr());
+}

+  final Component component;
+  final CoreTypes core;
+  final List<Library> libraries;
+  final ClassHierarchy hierarchy;
+  final bool buildSdk;
+  final ReferenceFromIndex? referenceFromIndex;
+  final ChangedStructureNotifier? changedStructureNotifier;
+  Reference? priorReference(Library library, Class? owner, Name name) {
+    final index = referenceFromIndex?.lookupLibrary(library);
+    return (owner == null ? index : index?.lookupIndexedClass(owner.name))
+        ?.lookupGetterReference(name);
+  }
+
+  Member? current;
+  final entries = <Object, Procedure>{};
+  late final extensionTargets = <Reference, Procedure>{
+    for (final library in component.libraries)
+      for (final descriptor in [
+        for (final extension in library.extensions)
+          for (final member in extension.memberDescriptors)
+            if (!member.isStatic &&
+                member.tearOffReference != null &&
+                member.memberReference != null)
+              (member.tearOffReference!, member.memberReference!),
+        for (final extension in library.extensionTypeDeclarations)
+          for (final member in extension.memberDescriptors)
+            if (!member.isStatic &&
+                member.tearOffReference != null &&
+                member.memberReference != null)
+              (member.tearOffReference!, member.memberReference!),
+      ])
+        descriptor.$1: descriptor.$2.asProcedure,
+  };
+  bool sameLayout(List<String> a, List<String> b) {
+    if (a.length != b.length) return false;
+    for (var i = 0; i < a.length; i++) {
+      if (a[i] != b[i]) return false;
+    }
+    return true;
+  }

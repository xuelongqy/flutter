+struct FlaxEpochTestState {
+  Dart_WeakPersistentHandle target = nullptr;
+  Dart_WeakPersistentHandle origin = nullptr;
+  Dart_WeakPersistentHandle dead = nullptr;
+  Dart_FlaxGCEpoch previous_epoch = 0;
+  bool target_finalized = false;
+  bool origin_finalized = false;
+  bool dead_finalized = false;
+  bool mark_target = true;
+  bool abort = false;
+  bool foreign = false;
+  GCType abort_type = GCType::kScavenge;
+  intptr_t origins = 0;
+  intptr_t requests = 0;
+};
+
+static void FlaxEpochOrigin(void* peer, Dart_WeakPersistentHandle origin) {
+  auto* state = static_cast<FlaxEpochTestState*>(peer);
+  EXPECT(Thread::Current()->OwnsGCSafepoint());
+  EXPECT_EQ(state->origin, origin);
+  ++state->origins;
+}
+
+static void FlaxEpochCollector(void* peer, Dart_FlaxGCEpoch epoch) {
+  auto* state = static_cast<FlaxEpochTestState*>(peer);
+  auto* thread = Thread::Current();
+  EXPECT(!thread->OwnsGCSafepoint());
+  EXPECT_EQ(Thread::kThreadInVM, thread->execution_state());
+  EXPECT(!Dart_FlaxSetCollector(nullptr, nullptr));
+  EXPECT(!Dart_FlaxGCCheckpoint(state->previous_epoch, nullptr, 0,
+                                FlaxEpochOrigin, state, nullptr));
+  state->previous_epoch = epoch;
+  bool all_targets_marked = true;
+  EXPECT(Dart_FlaxGCCheckpoint(epoch, nullptr, 0, FlaxEpochOrigin, state,
+                               &all_targets_marked));
+  EXPECT_EQ(0, state->origins);
+  EXPECT(!all_targets_marked);
+  if (state->abort) {
+    state->abort = false;
+    if (state->foreign) {
+      auto* group = thread->isolate_group();
+      std::thread collector([group] {
+        Thread::EnterIsolateGroupAsHelper(group, Thread::kUnknownTask,
+                                          /*bypass_safepoint=*/false);
+        auto* helper = Thread::Current();
+        helper->heap()->CollectGarbage(helper, GCType::kMarkSweep,
+                                       GCReason::kDebugging);
+        Thread::ExitIsolateGroupAsHelper(/*bypass_safepoint=*/false);
+      });
+      // The foreign collector must wait for our VM-state owner. Entering the
+      // checkpoint first services its request, which retires this generation.
+      while (!thread->IsSafepointRequested()) OS::SleepMicros(50);
+      EXPECT(!Dart_FlaxGCCheckpoint(epoch, nullptr, 0, FlaxEpochOrigin, state,
+                                    nullptr));
+      collector.join();
+    } else {
+      thread->heap()->CollectGarbage(thread, state->abort_type,
+                                     GCReason::kDebugging);
+    }
+    EXPECT(!Dart_FlaxGCCheckpoint(epoch, nullptr, 0, FlaxEpochOrigin, state,
+                                  nullptr));
+    EXPECT(!state->target_finalized);
+    EXPECT(!state->origin_finalized);
+    EXPECT(!state->dead_finalized);
+    return;
+  }
+  if (state->mark_target) {
+    EXPECT(Dart_FlaxGCCheckpoint(epoch, &state->target, 1, FlaxEpochOrigin,
+                                 state, &all_targets_marked));
+    EXPECT_EQ(1, state->origins);
+    EXPECT(!all_targets_marked);
+    // Reporting is per epoch, even when the same target is visited again.
+    EXPECT(Dart_FlaxGCCheckpoint(epoch, &state->target, 1, FlaxEpochOrigin,
+                                 state, nullptr));
+    EXPECT_EQ(1, state->origins);
+  }
+}
+
+static void FlaxEpochRequest(void* peer) {
+  ++static_cast<FlaxEpochTestState*>(peer)->requests;
+}
+
+static void CreateFlaxEpochTestGraph(FlaxEpochTestState* state) {
+  auto* thread = Thread::Current();
+  Dart_EnterScope();
+  ForceGrowthScope force_growth(thread);
+  Dart_Handle target, middle, origin, dead;
+  {
+    TransitionNativeToVM transition(thread);
+    target = Api::NewHandle(thread, Array::New(1));
+    middle = Api::NewHandle(thread, Array::New(1));
+    origin = Api::NewHandle(thread, Array::New(1));
+    dead = Api::NewHandle(thread, Array::New(1));
+  }
+  EXPECT_VALID(Dart_ListSetAt(target, 0, middle));
+  EXPECT_VALID(Dart_ListSetAt(middle, 0, origin));
+  EXPECT_VALID(Dart_ListSetAt(origin, 0, target));
+  EXPECT_VALID(Dart_ListSetAt(dead, 0, dead));
+  state->target = Dart_NewWeakPersistentHandle(
+      target, &state->target_finalized, 0, FlaxIncrementalCollectionFinalizer);
+  state->origin = Dart_NewWeakPersistentHandle(
+      origin, &state->origin_finalized, 0, FlaxIncrementalCollectionFinalizer);
+  state->dead = Dart_NewWeakPersistentHandle(
+      dead, &state->dead_finalized, 0, FlaxIncrementalCollectionFinalizer);
+  EXPECT(Dart_FlaxRegisterHandle(state->target, false));
+  EXPECT(Dart_FlaxRegisterHandle(state->origin, true));
+  EXPECT(Dart_FlaxRegisterHandle(state->dead, false));
+  Dart_ExitScope();
+}
+
+static void RunFlaxEpochTest(bool abort,
+                             GCType abort_type,
+                             bool foreign = false) {
+  auto* thread = Thread::Current();
+  {
+    TransitionNativeToVM transition(thread);
+    GCTestHelper::CollectAllGarbage();
+  }
+  FlaxEpochTestState state;
+  state.abort = abort;
+  state.abort_type = abort_type;
+  state.foreign = foreign;
+  EXPECT(Dart_FlaxSetCollector(FlaxEpochCollector, &state));
+  Dart_FlaxSetCollectionRequest(FlaxEpochRequest);
+  CreateFlaxEpochTestGraph(&state);
+  Dart_FlaxCollect(false, false);
+  EXPECT(!state.target_finalized);
+  EXPECT(!state.origin_finalized);
+  EXPECT_EQ(!abort, state.dead_finalized);
+  EXPECT_EQ(abort ? 0 : 1, state.origins);

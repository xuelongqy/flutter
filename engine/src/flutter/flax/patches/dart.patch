+// Experimental Flax cross-heap tracing. Not part of the public Dart API.
+#ifndef RUNTIME_INCLUDE_DART_FLAX_API_H_
+#define RUNTIME_INCLUDE_DART_FLAX_API_H_
+#include "dart_api.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+// The VM owns the epoch. The collector runs synchronously on its owner in VM
+// execution state, outside the GC safepoint. No application execution, ordinary
+// Dart API calls, microtasks, or heap allocation are allowed in the callback.
+typedef uint64_t Dart_FlaxGCEpoch;
+typedef void (*Dart_FlaxCollector)(void*, Dart_FlaxGCEpoch);
+// Try to stage Dart roots for an embedder major already in its atomic pause.
+// Zero leaves the caller in native state. A nonzero epoch requires a matching
+// Finish on this thread before leaving the pause. Only GCCheckpoint and Finish
+// may enter Dart during that interval, and no application code may execute.
+DART_EXPORT Dart_FlaxGCEpoch Dart_FlaxTryBeginEmbedderGC(void* collector_peer);
+// Reserve before taking the V8 Locker. A positive result is the number of
+// isolates in the stable group. The owner remains in native state until Begin.
+DART_EXPORT int32_t Dart_FlaxTryReserveEmbedderGC(void* collector_peer);
+// Release the matching reservation and return its full closed time in us.
+// Finish must already have returned if a marker was staged.
+DART_EXPORT int64_t Dart_FlaxReleaseEmbedderGCReservation(void);
+// Commit only after tracing has reached closure. A matching Finish restores
+// native state even if an intervening Dart GC retired the epoch. False means
+// there was no precise commit. Passing commit=false retains the Dart peers.
+DART_EXPORT bool Dart_FlaxFinishEmbedderGC(Dart_FlaxGCEpoch epoch, bool commit);
+// A checkpoint acquires a short GC safepoint, validates the epoch, and drains
+// ordinary strong/ephemeron marking before reporting newly reached origins.
+// The origin sink may only copy handle identities; it must not enter V8 or Dart.
+// No VM visitor escapes. False means the epoch was aborted by an intervening GC;
+// the collector must preserve all peers and request a fresh owner pass.
+DART_EXPORT bool Dart_FlaxGCCheckpoint(
+    Dart_FlaxGCEpoch epoch,
+    const Dart_WeakPersistentHandle* targets,
+    intptr_t target_count,
+    void (*origin_sink)(void*, Dart_WeakPersistentHandle),
+    void* peer,
+    bool* all_targets_marked);
+DART_EXPORT bool Dart_FlaxSetCollector(Dart_FlaxCollector collector,
+                                       void* peer);
+DART_EXPORT bool Dart_FlaxRegisterHandle(Dart_WeakPersistentHandle handle,
+                                         bool is_origin);
+DART_EXPORT void Dart_FlaxSetCollectionRequest(void (*request)(void*));
+// Controlled GC for this experiment, separate from automatic allocation GC.
+DART_EXPORT void Dart_FlaxCollect(bool young, bool compact);
+// Pin a writable Uint8List (or view) until its last native buffer owner releases
+// it. Pin/view calls require the owning isolate. Release runs on that isolate,
+// or on any thread after isolate shutdown has retired the root.
+typedef struct {
+  void* token;
+  void* data;
+  intptr_t byte_length;
+  intptr_t offset;
+  intptr_t length;
+} Dart_FlaxBuffer;
+DART_EXPORT Dart_Handle Dart_FlaxPinUint8List(Dart_Handle, Dart_FlaxBuffer*);
+DART_EXPORT void Dart_FlaxReleaseBuffer(void* token);
+DART_EXPORT Dart_Handle Dart_FlaxUint8ListView(void* token,
+                                              intptr_t offset,
+                                              intptr_t length);
+// Owning-isolate APIs. Errors are ordinary Dart API error handles.
+// Type parts: [display, nullable, library, declaration, children, shape, parents].
+DART_EXPORT Dart_Handle Dart_FlaxTypeParts(Dart_Handle type);
+// A null type constructs a runtime layout from sorted named fields.
+DART_EXPORT Dart_Handle Dart_FlaxRecordFields(Dart_Handle record);
+DART_EXPORT Dart_Handle Dart_FlaxNewRecord(Dart_Handle type, Dart_Handle names,
+                                         Dart_Handle fields);
+DART_EXPORT Dart_Handle Dart_FlaxNullableType(Dart_Handle type);
+DART_EXPORT Dart_Handle Dart_FlaxInstantiate(Dart_Handle closure, Dart_Handle types);
+#ifdef __cplusplus
+}
+#endif
+#endif

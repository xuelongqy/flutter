+// Valid only during the collector callback, on its owning thread. No Dart
+// execution, heap allocation, ordinary Dart API calls, or retained context.
+typedef struct {
+  void* context;
+  bool (*is_marked)(void*, Dart_WeakPersistentHandle);
+  void (*mark)(void*, Dart_WeakPersistentHandle);
+  Dart_WeakPersistentHandle (*next_marked_origin)(void*);
+} Dart_FlaxGC;
+typedef void (*Dart_FlaxCollector)(void*, const Dart_FlaxGC*);
+DART_EXPORT bool Dart_FlaxSetCollector(Dart_FlaxCollector collector,
+                                       void* peer);
+DART_EXPORT bool Dart_FlaxRegisterHandle(Dart_WeakPersistentHandle handle,
+                                         bool is_origin);
+DART_EXPORT void Dart_FlaxSetCollectionRequest(void (*request)(void*));
+// Controlled GC for this experiment, separate from automatic allocation GC.
+DART_EXPORT void Dart_FlaxCollect(bool young, bool compact);
+// Pin a writable Uint8List (or view) until its last native buffer owner releases
+// it. Pin/view calls require the owning isolate. Release runs on that isolate,
+// or on any thread after isolate shutdown has retired the root.
+typedef struct {
+  void* token;
+  void* data;
+  intptr_t byte_length;
+  intptr_t offset;
+  intptr_t length;
+} Dart_FlaxBuffer;
+DART_EXPORT Dart_Handle Dart_FlaxPinUint8List(Dart_Handle, Dart_FlaxBuffer*);
+DART_EXPORT void Dart_FlaxReleaseBuffer(void* token);
+DART_EXPORT Dart_Handle Dart_FlaxUint8ListView(void* token,
+                                              intptr_t offset,
+                                              intptr_t length);
+#ifdef __cplusplus
+}
+#endif
+#endif

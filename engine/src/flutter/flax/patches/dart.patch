+  if (!value.IsRecord()) return Api::NewArgumentError("Expected a Dart Record");
+  const auto& record = Record::Cast(value);
+  const auto& fields = Array::Handle(Z, Array::New(record.num_fields()));
+  auto& field = Object::Handle(Z);
+  for (intptr_t i = 0; i < record.num_fields(); ++i) {
+    field = record.FieldAt(i);
+    fields.SetAt(i, field);
+  }
+  return Api::NewHandle(T, fields.ptr());

+DART_EXPORT Dart_Handle Dart_FlaxNewRecord(Dart_Handle type_handle,
+                                          Dart_Handle names_handle,
+                                          Dart_Handle fields_handle) {
+  DARTSCOPE(Thread::Current());
+  CHECK_CALLBACK_STATE(T);
+  const auto& type = Object::Handle(Z, Api::UnwrapHandle(type_handle));
+  const auto& fields = Api::UnwrapArrayHandle(Z, fields_handle);
+  if (fields.IsNull()) return Api::NewArgumentError("Expected a field List");
+  const intptr_t count = fields.Length();
+  if (count > RecordShape::kMaxNumFields)
+    return Api::NewArgumentError("Too many Record fields");
+  RecordShape shape = RecordShape::ForUnnamed(count);
+  if (type.IsRecordType()) {
+    const auto& record_type = RecordType::Cast(type);
+    if (!record_type.IsInstantiated() || record_type.NumFields() != count)
+      return Api::NewArgumentError("Invalid Record field layout");
+    auto& field = Instance::Handle(Z);
+    auto& field_type = AbstractType::Handle(Z);
+    for (intptr_t i = 0; i < count; ++i) {
+      field ^= fields.At(i);
+      field_type = record_type.FieldTypeAt(i);
+      if (!field_type.IsTopType() &&
+          !field.IsInstanceOf(field_type, Object::null_type_arguments(),
+                              Object::null_type_arguments())) {
+        return Api::NewArgumentError("Incompatible Record field type");
+      }
+    }
+    shape = record_type.shape();
+  } else if (type.IsNull()) {
+    const auto& names = Api::UnwrapArrayHandle(Z, names_handle);
+    if (names.IsNull() || names.Length() > count)
+      return Api::NewArgumentError("Invalid Record field names");
+    const auto& interned = Array::Handle(
+        Z, names.Length() == 0 ? Object::empty_array().ptr()
+                               : Array::New(names.Length(), Heap::kOld));
+    auto& previous = String::Handle(Z);
+    auto& name = String::Handle(Z);
+    for (intptr_t i = 0; i < names.Length(); ++i) {
+      const auto& raw = Object::Handle(Z, names.At(i));
+      if (!raw.IsString()) return Api::NewArgumentError("Invalid Record field name");
+      name ^= raw.ptr();
+      if (name.Length() == 0 || name.CharAt(0) == '_' ||
+          (!previous.IsNull() && previous.CompareTo(name) >= 0))
+        return Api::NewArgumentError("Record names must be public, sorted and unique");
+      const char* text = name.ToCString();
+      if (strcmp(text, "hashCode") == 0 || strcmp(text, "runtimeType") == 0 ||
+          strcmp(text, "noSuchMethod") == 0 || strcmp(text, "toString") == 0)
+        return Api::NewArgumentError("Record name conflicts with Object");
+      // Dart identifiers use ASCII letters, digits, '_' and '$'.
+      for (intptr_t j = 0; j < name.Length(); ++j) {
+        const auto c = name.CharAt(j);
+        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+              c == '$' || c == '_' || (j > 0 && c >= '0' && c <= '9')))
+          return Api::NewArgumentError("Invalid Record field name");
+      }
+      // Keep reserved spellings aligned with the pinned front-end Keyword table.
+      static constexpr const char* reserved[] = {
+          "assert", "break", "case", "catch", "class", "const", "continue",
+          "default", "do", "else", "enum", "extends", "false", "final", "finally",
+          "for", "if", "in", "is", "new", "null", "rethrow", "return", "super",
+          "switch", "this", "throw", "true", "try", "var", "void", "while", "with"};
+      for (const char* keyword : reserved) {
+        if (strcmp(text, keyword) == 0)
+          return Api::NewArgumentError("Reserved Record field name");
+      }
+      // A named field cannot collide with a positional field accessor.
+      if (text[0] == '$' && text[1] >= '1' && text[1] <= '9') {
+        char* end = nullptr;
+        const auto position = strtoll(text + 1, &end, 10);
+        if (*end == '\0' && position > 0 && position <= count - names.Length())
+          return Api::NewArgumentError("Record name conflicts with positional field");
+      }
+      name ^= Symbols::New(T, name);
+      interned.SetAt(i, name);
+      previous = name.ptr();
+    }
+    interned.MakeImmutable();
+    shape = RecordShape::Register(T, count, interned);
+  } else {
+    return Api::NewArgumentError("Expected a concrete Record Type or null");
+  }
+  const auto& record = Record::Handle(Z, Record::New(shape));
+  auto& field = Instance::Handle(Z);
+  for (intptr_t i = 0; i < count; ++i) {
+    field ^= fields.At(i);
+    record.SetFieldAt(i, field);
+  }
+  return Api::NewHandle(T, record.ptr());
+}

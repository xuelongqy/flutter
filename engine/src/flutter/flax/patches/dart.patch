+void RetireFlaxBuffers(Thread* thread) {
+  NoSafepointScope no_safepoint(thread);
+  std::lock_guard<std::mutex> lock(uint8_pin_mutex);
+  for (auto it = uint8_pins.begin(); it != uint8_pins.end();) {
+    auto* pin = *it++;
+    if (pin->owner == thread->isolate()) ReleaseUint8Pin(pin);
+  }
+}
+
+DART_EXPORT Dart_Handle Dart_FlaxPinUint8List(Dart_Handle object,
+                                              Dart_FlaxBuffer* output) {
+  DARTSCOPE(Thread::Current());
+  if (!output) return Api::NewError("Null Uint8 buffer output");
+  *output = {};
+  auto cid = Api::ClassId(object);
+  if (IsUnmodifiableTypedDataViewClassId(cid) ||
+      (!IsTypedDataClassId(cid) && !IsExternalTypedDataClassId(cid) &&
+       !IsTypedDataViewClassId(cid)) ||
+      GetType(cid) != Dart_TypedData_kUint8)
+    return Api::NewError("Expected a writable Uint8List");
+
+  const auto& input = Object::Handle(Z, Api::UnwrapHandle(object));
+  auto& base = Object::Handle(Z, input.ptr());
+  output->offset = 0;
+  output->length = TypedDataBase::Cast(input).Length();
+  if (IsTypedDataViewClassId(cid)) {
+    const auto& view = TypedDataView::Cast(input);
+    output->offset = Smi::Value(view.offset_in_bytes());
+    base = view.typed_data();
+  }
+
+  if (base.IsTypedData() && base.ptr()->IsNewObject()) {
+    // Promote before publishing an address, so GC updates every existing alias.
+    T->heap()->CollectGarbage(T, GCType::kEvacuate, GCReason::kDebugging);
+    if (base.ptr()->IsNewObject())
+      return Api::NewError("Uint8List promotion failed");
+  }
+  // Resolve the page under the same guard that pins it; a safepoint between
+  // these operations could otherwise leave us pinning a stale page.
+  for (int attempt = 0; attempt < 2; ++attempt) {
+    {
+      NoSafepointScope no_safepoint(T);
+      Page* page = base.IsTypedData() ? Page::Of(base.ptr()) : nullptr;
+      if (!page || !page->is_evacuation_candidate()) {
+        auto* state = T->isolate_group()->api_state();
+        auto* root = state->AllocatePersistentHandle();
+        root->set_ptr(base);
+        auto* pin = new Uint8Pin{T->isolate(), state, root, page};
+        {
+          std::lock_guard<std::mutex> lock(uint8_pin_mutex);
+          if (page) {
+            auto [it, inserted] = uint8_pinned_pages.try_emplace(
+                page, Uint8PinnedPage{0, page->is_never_evacuate()});
+            ++it->second.users;
+            page->set_never_evacuate(true);
+          }
+          uint8_pins.insert(pin);
+        }
+        const auto& bytes = TypedDataBase::Cast(base);
+        output->data = bytes.DataAddr(0);
+        output->byte_length = bytes.LengthInBytes();
+        output->token = pin;
+        return Api::Success();
+      }
+    }
+    T->heap()->CollectAllGarbage(GCReason::kDebugging, false);
+  }
+  return Api::NewError("Uint8List evacuation did not finish");
+}
+
+DART_EXPORT void Dart_FlaxReleaseBuffer(void* token) {
+  auto* pin = static_cast<Uint8Pin*>(token);
+  Thread* thread = Thread::Current();
+  if (thread && thread->isolate() &&
+      thread->execution_state() == Thread::kThreadInNative) {
+    // Enter VM before locking: parking at a safepoint with this mutex held
+    // could block another isolate that needs it to reach the same safepoint.
+    TransitionToVM transition(thread);
+    NoSafepointScope no_safepoint(thread);
+    std::lock_guard<std::mutex> lock(uint8_pin_mutex);
+    if (pin->root) {
+      RELEASE_ASSERT(thread->isolate() == pin->owner);
+      ReleaseUint8Pin(pin);
+    }
+    delete pin;
+  } else {
+    std::lock_guard<std::mutex> lock(uint8_pin_mutex);
+    RELEASE_ASSERT(!pin->root);
+    delete pin;
+  }
+}
+
+DART_EXPORT Dart_Handle Dart_FlaxUint8ListView(void* token, intptr_t offset,
+                                               intptr_t length) {
+  DARTSCOPE(Thread::Current());
+  auto* pin = static_cast<Uint8Pin*>(token);
+  if (!pin || !pin->root || pin->owner != T->isolate())
+    return Api::NewError("Inactive Uint8 pin");
+  const auto& base = Object::Handle(Z, pin->root->ptr());
+  const auto& data = TypedDataBase::Cast(base);
+  if (offset < 0 || length < 0 || offset > data.LengthInBytes() ||
+      length > data.LengthInBytes() - offset)
+    return Api::NewError("Uint8 view range is out of bounds");
+  if (offset == 0 && length == data.Length() &&
+      GetType(base.GetClassId()) == Dart_TypedData_kUint8)
+    return Api::NewHandle(T, base.ptr());
+  return Api::NewHandle(
+      T, TypedDataView::New(kTypedDataUint8ArrayViewCid, data, offset, length));
+}

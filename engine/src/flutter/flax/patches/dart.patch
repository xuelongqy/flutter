+TEST_CASE(DartAPI_FlaxEpochOldTargetMovesAndFreshCleanup) {
+  {
+    TransitionNativeToVM transition(thread);
+    GCTestHelper::CollectAllGarbage();
+    GCTestHelper::WaitForGCTasks();
+  }
+  // Avoid preparatory evacuation that could recycle the source page.
+  SetFlagScope<bool> only_sliding(&FLAG_use_incremental_compactor, false);
+  FlaxEpochTestState state;
+  state.abort = true;
+  EXPECT(Dart_FlaxSetCollector(FlaxMovingCollector, &state));
+  Dart_FlaxSetCollectionRequest(FlaxEpochRequest);
+  constexpr int64_t kSentinel = 12345;
+  Dart_PersistentHandle business_root;
+  {
+    Dart_EnterScope();
+    ForceGrowthScope force_growth(thread);
+    Dart_Handle target, middle, origin, dead;
+    {
+      TransitionNativeToVM transition(thread);
+      // Old-space freelists can reuse holes in pages fixed after loading.
+      constexpr intptr_t kTargetLength = 1024;
+      constexpr intptr_t kMaxTargetAllocations = 2048;
+      ArrayPtr target_array = nullptr;
+      for (intptr_t attempt = 0; attempt < kMaxTargetAllocations; ++attempt) {
+        const ArrayPtr candidate = Array::New(kTargetLength, Heap::kOld);
+        if (!Page::Of(candidate)->is_never_evacuate()) {
+          target_array = candidate;
+          break;
+        }
+      }
+      RELEASE_ASSERT(target_array != nullptr);
+      target = Api::NewHandle(thread, target_array);
+      middle = Api::NewHandle(thread, Array::New(1, Heap::kOld));
+      origin = Api::NewHandle(thread, Array::New(1, Heap::kOld));
+      dead = Api::NewHandle(thread, Array::New(1, Heap::kOld));
+    }
+    EXPECT_VALID(Dart_ListSetAt(target, 0, Dart_NewInteger(kSentinel)));
+    EXPECT_VALID(Dart_ListSetAt(target, 1, target));
+    EXPECT_VALID(Dart_ListSetAt(target, 2, middle));
+    EXPECT_VALID(Dart_ListSetAt(middle, 0, origin));
+    EXPECT_VALID(Dart_ListSetAt(origin, 0, target));
+    EXPECT_VALID(Dart_ListSetAt(dead, 0, dead));
+    business_root = Dart_NewPersistentHandle(target);
+    state.target = Dart_NewWeakPersistentHandle(
+        target, &state.target_finalized, 0, FlaxIncrementalCollectionFinalizer);
+    state.origin = Dart_NewWeakPersistentHandle(
+        origin, &state.origin_finalized, 0, FlaxIncrementalCollectionFinalizer);
+    state.dead = Dart_NewWeakPersistentHandle(
+        dead, &state.dead_finalized, 0, FlaxIncrementalCollectionFinalizer);
+    EXPECT(Dart_FlaxRegisterHandle(state.target, false));
+    EXPECT(Dart_FlaxRegisterHandle(state.origin, true));
+    EXPECT(Dart_FlaxRegisterHandle(state.dead, false));
+    Dart_ExitScope();
+  }
+  Dart_FlaxCollect(false, false);
+  EXPECT(state.requests > 0);
+  EXPECT_EQ(1, state.origins);
+  {
+    Dart_EnterScope();
+    Dart_Handle target = AsHandle(state.target);
+    EXPECT_VALID(target);
+    EXPECT(
+        Dart_IdentityEquals(Dart_HandleFromPersistent(business_root), target));
+    int64_t value = 0;
+    EXPECT_VALID(Dart_IntegerToInt64(Dart_ListGetAt(target, 0), &value));
+    EXPECT_EQ(kSentinel, value);
+    EXPECT(Dart_IdentityEquals(Dart_ListGetAt(target, 1), target));
+    Dart_Handle origin = Dart_ListGetAt(Dart_ListGetAt(target, 2), 0);
+    EXPECT_VALID(origin);
+    EXPECT(Dart_IdentityEquals(origin, AsHandle(state.origin)));
+    EXPECT(Dart_IdentityEquals(Dart_ListGetAt(origin, 0), target));
+    // These local handles must not become roots for the fresh cleanup pass.
+    Dart_ExitScope();
+  }
+  Dart_DeletePersistentHandle(business_root);
+  Dart_FlaxCollect(false, false);
+  EXPECT_EQ(0, state.origins);
+  EXPECT(state.target_finalized);
+  EXPECT(state.origin_finalized);
+  EXPECT(state.dead_finalized);
+  {
+    Dart_EnterScope();
+    EXPECT(Dart_IsNull(AsHandle(state.target)));
+    EXPECT(Dart_IsNull(AsHandle(state.origin)));
+    EXPECT(Dart_IsNull(AsHandle(state.dead)));
+    Dart_ExitScope();
+  }
+  Dart_DeleteWeakPersistentHandle(state.target);
+  Dart_DeleteWeakPersistentHandle(state.origin);
+  Dart_DeleteWeakPersistentHandle(state.dead);
+  EXPECT(Dart_FlaxSetCollector(nullptr, nullptr));
+}

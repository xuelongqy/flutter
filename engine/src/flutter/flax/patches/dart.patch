+namespace {
+
+struct FlaxEmbedderGC {
+  FlaxEmbedderGC(Thread* owner, SafepointRwLock* lock)
+      // The reservation spans embedder calls, outside the VM unwind chain.
+      : owner(owner), isolates_lock(/*thread_state=*/nullptr, lock) {}
+
+  Thread* const owner;
+  SafepointReadRwLocker isolates_lock;
+  Dart_FlaxGCEpoch epoch = 0;
+  int64_t closed_at = -1;
+};
+
+thread_local std::optional<FlaxEmbedderGC> flax_embedder_gc;
+thread_local int64_t flax_cancelled_gate_micros = -1;
+
+bool FlaxCanEnterEmbedderGC(Thread* thread) {
+  return thread != nullptr && thread->isolate() != nullptr &&
+         thread->IsDartMutatorThread() && !thread->BypassSafepoints() &&
+         thread->execution_state() == Thread::kThreadInNative &&
+         thread->no_callback_scope_depth() == 0 &&
+         thread->no_safepoint_scope_depth() == 0 && !thread->OwnsSafepoint() &&
+         thread->IsAtSafepoint() && !thread->force_growth() &&
+         !FLAG_use_compactor && FLAG_marker_tasks > 0;
+}
+
+}  // namespace
+
+DART_EXPORT int32_t Dart_FlaxTryReserveEmbedderGC(void* collector_peer) {
+  Thread* thread = Thread::Current();
+  if (!FlaxCanEnterEmbedderGC(thread) || flax_embedder_gc ||
+      flax_cancelled_gate_micros != -1 ||
+      !thread->TryExitSafepointFromNative()) {
+    return 0;
+  }
+
+  // The fast exit proves this owner slot has not been stolen. The reservation
+  // prevents stealing until its release, including the time in native code.
+  thread->set_execution_state(Thread::kThreadInVM);
+  const int32_t isolates =
+      thread->heap()->TryReserveFlaxEmbedderGC(thread, collector_peer);
+  thread->set_execution_state(Thread::kThreadInNative);
+  thread->EnterSafepointToNative();
+  return isolates;
+}
+
+int32_t Heap::TryReserveFlaxEmbedderGC(Thread* thread, void* collector_peer) {
+  if (!thread->CanAcquireSafepointLocks()) return 0;
+
+  auto* group = isolate_group_;
+  auto& gc = flax_embedder_gc.emplace(thread, group->isolates_lock_.get());
+  intptr_t count = 0;
+  for (auto it = group->isolates_.begin(); it != group->isolates_.end(); ++it) {
+    ++count;
+  }
+  if (count < 1 || count > 2 || count != group->isolate_count_ ||
+      group->isolates_.First() != thread->isolate() ||
+      group->group_mutator_count_ != 0 ||
+      !group->TryCloseFlaxWorkerGate(thread, &gc.closed_at)) {
+    flax_embedder_gc.reset();
+    return 0;
+  }
+
+  // A concurrent job can have been queued without entering the registry.
+  // Check after closing admission, without nesting the scheduler monitors.
+  bool idle;
+  {
+    MonitorLocker ml(old_space_.tasks_lock());
+    idle = old_space_.phase() == PageSpace::kDone && old_space_.tasks() == 0;
+  }
+  auto* api = group->api_state();
+  if (!idle || thread->is_marking() || api->flax_epoch() != 0 ||
+      api->flax_callback_active() || api->flax_owner() != thread ||
+      api->flax_collector() == nullptr || api->flax_peer() != collector_peer) {
+    ReleaseFlaxWorkerGate(thread);
+    return 0;
+  }
+  return count;
+}
+
+int64_t Heap::ReleaseFlaxWorkerGate(Thread* thread) {
+  RELEASE_ASSERT(flax_embedder_gc && flax_embedder_gc->owner == thread);
+  RELEASE_ASSERT(flax_embedder_gc->epoch == 0 && !thread->OwnsSafepoint());
+  const int64_t closed_at = flax_embedder_gc->closed_at;
+  RELEASE_ASSERT(closed_at >= 0);
+  flax_embedder_gc.reset();
+  return isolate_group_->OpenFlaxWorkerGate(thread, closed_at);
+}
+
+void Heap::CancelFlaxWorkerGateOnIsolateExit(Thread* thread) {
+  if (flax_embedder_gc && flax_embedder_gc->owner == thread) {
+    // For example, a group-bound FFI callback may deschedule the owner before
+    // the foreground pump reaches a major. Release before it tries to reenter.
+    flax_cancelled_gate_micros = thread->heap()->ReleaseFlaxWorkerGate(thread);
+  }
+}
+
+DART_EXPORT int64_t Dart_FlaxReleaseEmbedderGCReservation() {
+  if (flax_cancelled_gate_micros != -1) {
+    return std::exchange(flax_cancelled_gate_micros, -1);
+  }
+  Thread* thread = Thread::Current();
+  RELEASE_ASSERT(thread != nullptr);
+  return thread->heap()->ReleaseFlaxWorkerGate(thread);
+}
+
+DART_EXPORT Dart_FlaxGCEpoch Dart_FlaxTryBeginEmbedderGC(void* collector_peer) {
+  Thread* thread = Thread::Current();
+  if (!FlaxCanEnterEmbedderGC(thread) || !flax_embedder_gc ||
+      flax_embedder_gc->owner != thread || flax_embedder_gc->epoch != 0) {
+    return 0;
+  }
+
+  thread->ExitSafepointFromNative();
+  thread->set_execution_state(Thread::kThreadInVM);
+  const Dart_FlaxGCEpoch epoch =
+      thread->heap()->TryBeginFlaxEmbedderGC(thread, collector_peer);
+  RELEASE_ASSERT(!thread->OwnsSafepoint() && !thread->IsAtSafepoint());
+  if (epoch == 0) {
+    thread->set_execution_state(Thread::kThreadInNative);
+    thread->EnterSafepointToNative();
+  }
+  return epoch;
+}
+
+Dart_FlaxGCEpoch Heap::TryBeginFlaxEmbedderGC(Thread* thread,
+                                            void* collector_peer) {
+  auto* api = isolate_group_->api_state();
+  NoActiveIsolateScope no_active_isolate_scope(thread);
+  GcSafepointOperationScope safepoint_operation(thread);
+  {
+    MonitorLocker ml(old_space_.tasks_lock());
+    if (old_space_.phase() != PageSpace::kDone || old_space_.tasks() != 0) {
+      TIMELINE_FUNCTION_GC_DURATION(thread, "FlaxJoinRejectDartHeapBusy");
+      return 0;
+    }
+  }
+  if (thread->is_marking() || api->flax_epoch() != 0 ||
+      api->flax_callback_active() || api->flax_owner() != thread ||
+      api->flax_collector() == nullptr || api->flax_peer() != collector_peer) {
+    TIMELINE_FUNCTION_GC_DURATION(thread, "FlaxJoinRejectDartOwnership");
+    return 0;
+  }
+  CollectOldSpaceGarbageAtSafepoint(thread, GCType::kMarkSweep,
+                                    GCReason::kDebugging,
+                                    /*defer_flax_tracing=*/false,
+                                    /*stage_flax=*/true);
+  const auto epoch = api->flax_epoch();
+  RELEASE_ASSERT(epoch != 0);
+  flax_embedder_gc->epoch = epoch;
+  api->set_flax_callback_active(true);
+  thread->IncrementNoCallbackScopeDepth();
+  return epoch;
+}
+
+DART_EXPORT bool Dart_FlaxFinishEmbedderGC(Dart_FlaxGCEpoch epoch,
+                                           bool commit) {
+  Thread* thread = Thread::Current();
+  if (!flax_embedder_gc || flax_embedder_gc->owner != thread || epoch == 0 ||
+      flax_embedder_gc->epoch != epoch) {
+    return false;
+  }
+  RELEASE_ASSERT(thread->execution_state() == Thread::kThreadInVM);
+  RELEASE_ASSERT(!thread->OwnsSafepoint() && !thread->IsAtSafepoint());
+  RELEASE_ASSERT(thread->no_callback_scope_depth() == 1);
+  RELEASE_ASSERT(thread->no_safepoint_scope_depth() == 0);
+  const bool committed =
+      thread->heap()->FinishFlaxEmbedderGC(thread, epoch, commit);
+  RELEASE_ASSERT(!thread->OwnsSafepoint() && !thread->IsAtSafepoint());
+  flax_embedder_gc->epoch = 0;
+  thread->DecrementNoCallbackScopeDepth();
+  thread->set_execution_state(Thread::kThreadInNative);
+  thread->EnterSafepointToNative();
+  return committed;
+}
+
+bool Heap::FinishFlaxEmbedderGC(Thread* thread,
+                                Dart_FlaxGCEpoch epoch,
+                                bool commit) {
+  NoActiveIsolateScope no_active_isolate_scope(thread);
+  GcSafepointOperationScope safepoint_operation(thread);
+  auto* api = isolate_group_->api_state();
+  RELEASE_ASSERT(api->flax_owner() == thread && api->flax_callback_active());
+  // Acquiring the safepoint can park the owner for a foreign GC. In that
+  // case the old visitor is gone and the foreign GC has kept the Dart peers.
+  if (api->flax_epoch() == epoch) {
+    RELEASE_ASSERT(old_space_.phase() == PageSpace::kAwaitingFlax);
+    CollectOldSpaceGarbageAtSafepoint(thread, GCType::kMarkSweep,
+                                      GCReason::kDebugging,
+                                      /*defer_flax_tracing=*/!commit,
+                                      /*stage_flax=*/false);
+  } else {
+    RELEASE_ASSERT(api->flax_epoch() == 0);
+    api->RequestFlaxCollection();
+    commit = false;
   }
+  api->set_flax_callback_active(false);
+  return commit;
 }
 

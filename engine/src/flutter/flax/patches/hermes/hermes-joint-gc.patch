+void HadesGC::traceFlaxRoots(bool complete) {
+  if (!flaxRoots)
+    return;
+  FlaxGC visitor{
+      this, complete,
+      [](void *, const GCCell *cell) {
+        return cell && AlignedHeapSegment::getCellMarkBit(cell);
+      },
+      [](void *context, GCCell *cell) {
+        if (cell) {
+          MarkAcceptor acceptor{*static_cast<HadesGC *>(context)};
+          acceptor.acceptRoot(cell);
+        }
+      },
+      [](void *context) {
+        auto &gc = *static_cast<HadesGC *>(context);
+        gc.incrementalMark(std::numeric_limits<size_t>::max());
+        gc.markWeakMapEntrySlots();
+      }};
+  flaxRoots(visitor);

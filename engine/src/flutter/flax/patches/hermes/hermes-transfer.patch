+// ArrayBufferCopyAndDetach for fixed-length, unshared ArrayBuffers.
+CallResult<HermesValue> arrayBufferPrototypeTransfer(void *, Runtime &runtime) {
+  NativeArgs args = runtime.getCurrentFrame().getNativeArgs();
+  auto self = args.dyncastThis<JSArrayBuffer>();
+  if (!self) {
+    return runtime.raiseTypeError("transfer called on a non-ArrayBuffer");
+  }
+  uint64_t length = self->size();
+  if (!args.getArg(0).isUndefined()) {
+    auto result = toIndex(runtime, args.getArgHandle(0));
+    if (result == ExecutionStatus::EXCEPTION) {
+      return ExecutionStatus::EXCEPTION;
+    }
+    length = result->getNumberAs<uint64_t>();
+  }
+  // Conversion can execute user code and detach the source.
+  if (!self->attached()) {
+    return runtime.raiseTypeError("Detached ArrayBuffer");
+  }
+  if (length > std::numeric_limits<JSArrayBuffer::size_type>::max()) {
+    return runtime.raiseRangeError("Too large of a byteLength requested");
+  }
+  struct : public Locals {
+    PinnedValue<JSArrayBuffer> target;
+  } lv;
+  LocalsRAII lraii(runtime, &lv);
+  lv.target.castAndSetHermesValue<JSArrayBuffer>(
+      JSArrayBuffer::create(
+          runtime, Handle<JSObject>::vmcast(&runtime.arrayBufferPrototype))
+          .getHermesValue());
+  if (JSArrayBuffer::createDataBlock(runtime, lv.target, length) ==
+      ExecutionStatus::EXCEPTION) {
+    return ExecutionStatus::EXCEPTION;
+  }
+  JSArrayBuffer::copyDataBlockBytes(
+      runtime, *lv.target, 0, *self, 0, std::min<uint64_t>(length, self->size()));
+  JSArrayBuffer::detach(runtime, self);
+  return lv.target.getHermesValue();
+}

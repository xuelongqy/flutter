+// Integer-indexed exotic objects must not create ordinary numeric properties.
+static CallResult<bool> invalidTypedArrayIndex(
+    Handle<JSObject> object,
+    Runtime &runtime,
+    Handle<> key) {
+  auto array = Handle<JSTypedArrayBase>::dyn_vmcast(object);
+  if (!array || key->isSymbol())
+    return false;
+
+  double index;
+  if (key->isNumber()) {
+    // ToPropertyKey converts a numeric -0 to the string "0".
+    index = key->getNumber();
+  } else {
+    auto textResult = toString_RJS(runtime, key);
+    if (textResult == ExecutionStatus::EXCEPTION)
+      return ExecutionStatus::EXCEPTION;
+    auto text = StringPrimitive::ensureFlat(
+        runtime, runtime.makeHandle(std::move(*textResult)));
+    if (text->getStringLength() == 2 && text->at(0) == '-' && text->at(1) == '0')
+      return true;
+    auto number = toNumber_RJS(runtime, text);
+    if (number == ExecutionStatus::EXCEPTION)
+      return ExecutionStatus::EXCEPTION;
+    index = number->getNumber();
+    auto canonical = numberToStringPrimitive(runtime, index);
+    if (canonical == ExecutionStatus::EXCEPTION)
+      return ExecutionStatus::EXCEPTION;
+    if (!text->equals(canonical->get()))
+      return false;
+  }
+  return !array->attached(runtime) || !std::isfinite(index) || index < 0 ||
+      std::floor(index) != index || index >= array->getLength();
+}

+bool JointHeap::InstallFixturePeerControl() {
+  if (incremental_joint_mode_ != 1 || collecting_ || joint_epoch_ ||
+      !fixture_context_.IsEmpty() || v8::Isolate::TryGetCurrent() != isolate_)
+    return false;
+  v8::HandleScope handles(isolate_);
+  auto ctx = isolate_->GetCurrentContext();
+  if (ctx.IsEmpty() || ctx != isolate_->GetEnteredOrMicrotaskContext() ||
+      ctx->GetNumberOfEmbedderDataFields() <= v8rt::ContextEmbedderIndex::kContextTag ||
+      ctx->GetAlignedPointerFromEmbedderData(v8rt::ContextEmbedderIndex::kContextTag,
+          v8::kEmbedderDataTypeTagDefault) != v8rt::RuntimeContextTagPtr)
+    return false;
+  const auto* session = ctx->GetAlignedPointerFromEmbedderData(
+      v8rt::ContextEmbedderIndex::kRuntime, v8::kEmbedderDataTypeTagDefault);
+  if (!session)
+    return false;
+  auto name = v8::String::NewFromUtf8Literal(isolate_, "__fixturePeerControl");
+  if (ctx->Global()->HasOwnProperty(ctx, name).FromMaybe(true))
+    return false;
+  auto data = v8::External::New(isolate_, this, v8::kExternalPointerTypeTagDefault);
+  v8::Local<v8::Function> control;
+  if (!v8::Function::New(ctx, FixturePeerControl, data, 2,
+                         v8::ConstructorBehavior::kThrow).ToLocal(&control) ||
+      !ctx->Global()->CreateDataProperty(ctx, name, control).FromMaybe(false))
+    return false;
+  fixture_context_.Reset(isolate_, ctx);
+  fixture_session_ = session;
+  return true;
+}
+
+void JointHeap::FixturePeerControl(
+    const v8::FunctionCallbackInfo<v8::Value>& args) {
+  auto* isolate = args.GetIsolate();
+  auto* heap = static_cast<JointHeap*>(args.Data().As<v8::External>()->Value(
+      v8::kExternalPointerTypeTagDefault));
+  args.GetReturnValue().Set(false);
+  if (std::this_thread::get_id() != heap->owner_ || heap->closed_ ||
+      Dart_CurrentIsolate() != heap->dart_isolate_ || heap->collecting_ ||
+      heap->joint_epoch_ || heap->fixture_context_.IsEmpty() ||
+      !args[0]->IsInt32())
+    return;
+  auto ctx = heap->fixture_context_.Get(isolate);
+  if (ctx != isolate->GetCurrentContext() ||
+      ctx != isolate->GetEnteredOrMicrotaskContext())
+    return;
+  const int op = args[0].As<v8::Int32>()->Value();
+  if (op == 3) {
+    args.GetReturnValue().Set(static_cast<double>(
+        heap->major_epilogues_.load(std::memory_order_relaxed)));
+    return;
+  }
+  auto key = heap->peers_key_.Get(isolate);
+  if (op == 0) {
+    auto wrapper = v8::Object::New(isolate, v8::Null(isolate), nullptr, nullptr, 0);
+    if (wrapper->SetPrivate(ctx, key, v8::True(isolate)).FromMaybe(false))
+      args.GetReturnValue().Set(wrapper);
+    return;
+  }
+  if ((op != 1 && op != 2) || !heap->fixture_session_ ||
+      !args[1]->IsObject() || args[1]->IsProxy())
+    return;
+  auto wrapper = args[1].As<v8::Object>();
+  v8::Local<v8::Context> creation;
+  v8::Local<v8::Value> carrier;
+  if (!wrapper->GetCreationContext(isolate).ToLocal(&creation) ||
+      creation != ctx || !wrapper->GetPrivate(ctx, key).ToLocal(&carrier) ||
+      !carrier->IsObject())
+    return;
+  auto* peer = v8::Object::Unwrap<tag, JointPeer>(isolate, carrier.As<v8::Object>());
+  if (!peer || peer->value.Get(isolate) != wrapper)
+    return;
+  for (auto* cell : peer->cells) {
+    if (!cell->fixture_target || cell->session != heap->fixture_session_ ||
+        !cell->target || cell->origin || cell->cleanup || cell->cleanup_data)
+      continue;
+    if (op == 2)
+      heap->Remove(cell);
+    args.GetReturnValue().Set(true);
+    return;
+  }
+}

# Linker script that exports the minimal symbols required for libflutter.so

{
  global:
    JNI_OnLoad;
    flax_engine_get_api;
    flax_engine_get_gc_api;
    flax_engine_get_binding_api;
    flax_get_engine_execution_api;
    flax_engine_get_modules_api;
    flax_canvas_version;
    flax_canvas_dispatch;
    _binary_icudtl_dat_start;
    _binary_icudtl_dat_size;
    InternalFlutterGpu*;
    kInternalFlutterGpu*;
  local:
    *;
};
